package(default_visibility = ["//visibility:public"])

cc_library(
    name = "skia",
    hdrs = glob(["include/**/*.h"]),
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = [
            "src/gpu/**/*.cpp",
            "src/android/**/*.cpp",
            "src/codec/**/*.cpp",
            "src/pdf/**/*.cpp",
            "src/ports/SkDebug_android.cpp",
            "src/ports/SkDebug_win.cpp",
            "src/ports/SkFontConfigInterface*.cpp",
            "src/ports/SkFontHost_FreeType*.cpp",
            "src/ports/SkFontMgr_android*.cpp",
            "src/ports/SkFontMgr_custom*.cpp",
            "src/ports/fontations/**/*.cpp",
            "src/ports/SkFontMgr_fontations*.cpp",
            "src/ports/SkFontMgr_fontconfig*.cpp",
            "src/ports/SkFontMgr_FontConfigInterface*.cpp",
            "src/ports/SkFontMgr_fuchsia.cpp",
            "src/ports/SkFontMgr_win_dw.cpp",
            "src/ports/SkFontScanner_fontations.cpp",
            "src/ports/SkImageEncoder_NDK.cpp",
            "src/ports/SkImageGeneratorNDK.cpp",
            "src/ports/SkImageGeneratorWIC.cpp",
            "src/ports/SkImageGenerator_skia.cpp",
            "src/ports/SkMemory_mozalloc.cpp",
            "src/ports/SkNDKConversions.cpp",
            "src/ports/SkOSFile_win.cpp",
            "src/ports/SkOSLibrary_win.cpp",
            "src/ports/SkScalerContext_win_dw.cpp",
            "src/ports/SkTypeface_fontations.cpp",
            "src/ports/SkTypeface_win_dw.cpp",
            "src/ports/SkImageGeneratorCG.cpp",
            "src/encode/SkJPEGWriteUtility.cpp",
            "src/encode/SkJpegEncoderImpl.cpp",
            "src/encode/SkWebpEncoderImpl.cpp",
            "src/encode/SkPngEncoderImpl.cpp",
            "src/encode/SkJpegGainmapEncoder.cpp",
            "src/sksl/lex/**/*.cpp",
        ],
    ),
    includes = [
        ".",
        "include",
        "include/core",
        "include/config",
        "include/encode",
        "include/effects",
        "include/pathops",
        "include/utils",
        "include/codec",
        "src",
        "src/base",
        "src/core",
        "src/shaders",
        "src/image",
        "src/effects",
        "src/text",
        "src/ports",
        "src/utils",
        "src/encode",
        "src/pathops",
        "src/sfnt",
        "src/sksl",
    ],
    copts = [
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    linkopts = select({
        "@native_ui//platforms:macos_arm64": [
            "-framework ApplicationServices",
            "-framework CoreGraphics",
            "-framework CoreText",
            "-framework Metal",
        ],
        "//conditions:default": [],
    }),
)
